<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Settings.app pane for Passages.

  A Settings bundle rather than an in-app screen: this is a rarely-touched
  machine address, and the app deliberately has no chrome that competes with
  the paper. Adding a settings button to the reader would spend UI budget on
  something changed roughly never.

  PSMultiValueSpecifier, not PSTextFieldSpecifier, because every reachable host
  must also be listed in NSExceptionDomains in project.yml. A typed address
  would sail past this pane and die at App Transport Security with no error the
  user can see. Values here must match SyncClient.nodes and the ATS list.
-->
<plist version="1.0">
<dict>
    <key>StringsTable</key>
    <string>Root</string>
    <key>PreferenceSpecifiers</key>
    <array>
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Sync</string>
            <key>FooterText</key>
            <string>Which laptop serves the reading queue. The always-on laptop is the default because it does not sleep; a sleeping server looks identical to a broken app from in here.</string>
        </dict>
        <dict>
            <key>Type</key>
            <string>PSMultiValueSpecifier</string>
            <key>Title</key>
            <string>Server</string>
            <key>Key</key>
            <string>serverAddress</string>
            <key>DefaultValue</key>
            <string>100.77.134.90</string>
            <key>Titles</key>
            <array>
                <string>Always-on laptop</string>
                <string>ThinkPad</string>
            </array>
            <key>Values</key>
            <array>
                <string>100.77.134.90</string>
                <string>100.117.163.83</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
